{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "evaluate_tracker",
            "type": "shell",
            "command": "python server/inference/optimization/evaluate_tracker.py --golden-dir ${input:golden-dir} --tracker ${input:tracker}",
            "problemMatcher": []
        },
        {
            "label": "annotate_tracklets",
            "type": "shell",
            "command": "python server/inference/optimization/annotate_tracklets.py ${input:video-dir} --output-dir ${input:golden-dir}",
            "problemMatcher": []
        },
        {
            "label": "optimize_ILP",
            "type": "shell",
            "command": "python server/inference/optimization/optimize_tracker.py --golden-dir ${input:golden-dir} --mode ilp",
            "problemMatcher": []
        },
        {
            "label": "optimize_BoTSort",
            "type": "shell",
            "command": "python server/inference/optimization/optimize_tracker.py --golden-dir ${input:golden-dir} --mode botsort",
            "problemMatcher": []
        },
        {
            "label": "optimize_preprocessor",
            "type": "shell",
            "command": "python server/inference/optimization/optimize_tracker.py --golden-dir ${input:golden-dir} --mode preprocessor",
            "problemMatcher": []
        },
        {
            "label": "optimize_iter_ilp",
            "type": "shell",
            "command": "python server/inference/optimization/optimize_tracker.py --golden-dir ${input:golden-dir} --mode iter_ilp",
            "problemMatcher": []
        },
        {
            "label": "optimize_detection_thresholds",
            "type": "shell",
            "command": "python server/inference/optimization/optimize_detection_thresholds.py --golden-dir ${input:golden-dir}",
            "problemMatcher": []
        },
        {
            "label": "optimize_pairwise_association",
            "type": "shell",
            "command": "python server/inference/optimization/optimize_pairwise_association.py --golden-dir ${input:golden-dir}",
            "problemMatcher": []
        },
        {
            "label": "compare_trackers",
            "type": "shell",
            "command": "python server/inference/optimization/compare_trackers.py --golden-dir ${input:golden-dir} --tracker iter_ilp",
            "problemMatcher": []
        },
        {
            "label": "compare_preprocessor",
            "type": "shell",
            "command": "python server/inference/optimization/compare_trackers.py --golden-dir ${input:golden-dir} --tracker preprocessor",
            "problemMatcher": []
        },
        {
            "label": "run_local_inference",
            "type": "shell",
            "command": "python -m server.inference.src.local_inference_main ${input:video-dir}",
            "problemMatcher": []
        },
        {
            "label": "local_player",
            "type": "shell",
            "command": "python -m server.inference.src.local_player_main \"C:\\Projects\\Windsurf-Analysis\\tmp\\test\"",
            "problemMatcher": []
        },
        {
            "label": "deploy",
            "type": "shell",
            "command": "python deploy.py",
            "problemMatcher": []
        },
        {
            "label": "serve",
            "type": "shell",
            "command": "cd server/frontend && npm run build && npm run preview",
            "problemMatcher": []
        },
        {
            "label": "deploy_backend",
            "type": "shell",
            "command": "cd backend && gcloud run deploy backend --source . --allow-unauthenticated",
            "problemMatcher": []
        },
        {
            "label": "deploy_frontend",
            "type": "shell",
            "command": "cd frontend && firebase deploy --only hosting",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "golden-dir",
            "default": "tmp/golden",
            "type": "promptString",
            "description": "Golden directory"
        },
        {
            "id": "video-dir",
            "default": "tmp/test/*.mp4",
            "type": "promptString",
            "description": "Video directory"
        },
        {
            "id": "tracker",
            "default": "ilp",
            "type": "promptString",
            "description": "Tracker"
        }
    ]
}
