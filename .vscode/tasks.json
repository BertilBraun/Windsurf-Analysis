        },
        {
            "label": "serve",
            "type": "shell",
            "command": "cd video_processing/frontend && npm run build && npm run preview",
            "problemMatcher": []
        },
        {
            "label": "deploy_backend",
            "type": "shell",
            "command": "cd backend && gcloud run deploy backend --source . --allow-unauthenticated",
            "problemMatcher": []
        },
        {
            "label": "run_backend_local",
            "type": "shell",
            "command": "cd backend && python main.py",
            "problemMatcher": []
        },
        {
            "label": "deploy_frontend",
            "type": "shell",
            "command": "cd frontend && npm run build && firebase deploy --only hosting",
            "problemMatcher": []
        },
        {
            "label": "run_frontend_local",
            "type": "shell",
            "command": "cd frontend && npm run dev",
            "problemMatcher": []
        },
        {
            "label": "deploy_video_processing",
            "type": "shell",
            "command": "cd video_processing && python deploy.py",
            "problemMatcher": []
        },
        {
            "label": "local_modal_pipeline",
            "type": "shell",
