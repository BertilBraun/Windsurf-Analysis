            "type": "shell",
            "command": "python video_processing/inference/optimization/optimize_pairwise_association.py --golden-dir ${input:golden-dir}",
            "problemMatcher": []
        },
        {
            "label": "compare_trackers",
            "type": "shell",
            "command": "python video_processing/inference/optimization/compare_trackers.py --golden-dir ${input:golden-dir} --tracker iter_ilp",
