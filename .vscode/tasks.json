            "description": "Tracker"
        },
        {
            "id": "video-file",
            "default": "tmp/test/input3.mp4",
            "type": "promptString",
            "description": "Single Video File"
        },
        {
            "id": "track-id",
            "default": "1",
            "type": "promptString",
            "description": "Track ID"
        }
    ]
