    "version": "2.0.0",
    "tasks": [
        {
            "label": "evaluate_tracker",
            "type": "shell",
            "command": "python video_processing/inference/optimization/evaluate_tracker.py --golden-dir ${input:golden-dir} --tracker ${input:tracker}",
            "problemMatcher": []
        },
        {
            "label": "annotate_tracklets",
            "type": "shell",
            "command": "python video_processing/inference/optimization/annotate_tracklets.py ${input:video-dir} --output-dir ${input:golden-dir}",
            "problemMatcher": []
        },
        {
            "label": "optimize_ILP",
            "type": "shell",
            "command": "python video_processing/inference/optimization/optimize_tracker.py --golden-dir ${input:golden-dir} --mode ilp",
            "problemMatcher": []
        },
        {
            "label": "optimize_BoTSort",
            "type": "shell",
            "command": "python video_processing/inference/optimization/optimize_tracker.py --golden-dir ${input:golden-dir} --mode botsort",
            "problemMatcher": []
        },
        {
            "label": "optimize_preprocessor",
            "type": "shell",
            "command": "python video_processing/inference/optimization/optimize_tracker.py --golden-dir ${input:golden-dir} --mode preprocessor",
