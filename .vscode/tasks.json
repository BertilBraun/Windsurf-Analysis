            "command": "python video_processing/scripts/local_modal_pipeline_player.py --input-video \"C:\\Projects\\Windsurf-Analysis\\tmp\\ingress\\small test\\test folder\\another sub folder\\test\\New folder\\New folder\\F_J.mp4\" --skip-orientation",
            "problemMatcher": []
        },
        {
            "label": "render_homepage",
            "type": "shell",
            "command": "python video_processing/scripts/render_homepage_demo.py --input-video \"${input:video-file}\" --skip-orientation --track-id ${input:track-id}",
